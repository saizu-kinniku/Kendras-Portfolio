---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { SiteImage } from '../data/projects';
// Schriften früh laden, damit nichts nachspringt
import fontHead from '@fontsource/stack-sans-headline/files/stack-sans-headline-latin-400-normal.woff2?url';
import fontBody from '@fontsource/syne/files/syne-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Vorschaubild beim Teilen (WhatsApp, Instagram, LinkedIn …) */
  image?: SiteImage;
  active?: 'illustration' | 'design' | 'about';
  noindex?: boolean;
}

const {
  title,
  description: rawDescription,
  image,
  active,
  noindex = false,
} = Astro.props;

const fallbackDescription = 'Kendra Schlegel – illustrator and graphic designer based in Switzerland.';
const description = (rawDescription?.trim() || fallbackDescription).replace(/\s+/g, ' ').slice(0, 160);
const fullTitle = title ? `${title} – Kendra Schlegel` : 'Kendra Schlegel – Illustration and Graphic Design';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = image ? image.src.replace(/w=\d+/, 'w=1200') : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={fontHead} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontBody} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      // Für Einblend-Effekte (ohne JavaScript bleibt alles sofort sichtbar)
      document.documentElement.classList.add('js');
      // Beim Seitenwechsel übernimmt der Überblend-Effekt – dann keine zusätzliche Einblendung
      addEventListener('pagereveal', (e) => {
        if (e.viewTransition) document.documentElement.classList.add('vt');
      });
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kendra Schlegel" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {image?.alt && <meta property="og:image:alt" content={image.alt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  </head>
  <body id="top">
    <Nav active={active} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';

  // Bilder blenden weich ein, sobald sie geladen sind (bereits geladene erscheinen sofort)
  document.querySelectorAll<HTMLImageElement>('img.img-fade').forEach((img) => {
    const show = () => img.classList.add('is-loaded');
    if (img.complete && img.naturalWidth) {
      img.style.transition = 'none';
      show();
      requestAnimationFrame(() => img.style.removeProperty('transition'));
    } else {
      img.addEventListener('load', show, { once: true });
      img.addEventListener('error', show, { once: true });
    }
  });

  // Leichtes Smooth Scrolling (Mausrad/Trackpad; Touch bleibt nativ)
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const lenis = new Lenis({ lerp: 0.12, anchors: true, autoRaf: true });
    // Mobiles Menü offen → Seite darunter nicht scrollen
    new MutationObserver(() => {
      if (document.documentElement.classList.contains('menu-open')) lenis.stop();
      else lenis.start();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  }
</script>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
