---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { SiteImage } from '../data/projects';
// Schriften früh laden, damit nichts nachspringt
import fontHead from '@fontsource/stack-sans-headline/files/stack-sans-headline-latin-400-normal.woff2?url';
import fontBody from '@fontsource/syne/files/syne-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Vorschaubild beim Teilen (WhatsApp, Instagram, LinkedIn …) */
  image?: SiteImage;
  active?: 'illustration' | 'design' | 'about';
  noindex?: boolean;
}

const {
  title,
  description: rawDescription,
  image,
  active,
  noindex = false,
} = Astro.props;

const fallbackDescription = 'Kendra Schlegel – illustrator and graphic designer based in Switzerland.';
const description = (rawDescription?.trim() || fallbackDescription).replace(/\s+/g, ' ').slice(0, 160);
const fullTitle = title ? `${title} – Kendra Schlegel` : 'Kendra Schlegel – Illustration and Graphic Design';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = image ? image.src.replace(/w=\d+/, 'w=1200') : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={fontHead} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontBody} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kendra Schlegel" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {image?.alt && <meta property="og:image:alt" content={image.alt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  </head>
  <body id="top">
    <Nav active={active} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>
