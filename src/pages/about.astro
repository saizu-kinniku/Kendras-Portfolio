---
/** Figma: "About & Contact" */
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Img from '../components/Img.astro';
import { getAbout, getSettings } from '../lib/content';

const about = await getAbout();
const { email } = await getSettings();
---

<Base title="About & Contact" active="about" description={about.lead} image={about.portrait}>
  <section class="about">
    <div class="text-col">
      <div class="text">
        <h1 class="hello">{about.greeting}</h1>
        <p class="t-subline lead">{about.lead}</p>
        <div class="t-body body" set:html={about.bodyHtml} />
      </div>
    </div>
    <div class="portrait">
      {about.portrait && <Img image={about.portrait} sizes="(max-width: 700px) 100vw, 45vw" loading="eager" />}
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="illu">
      {about.contactIllustration && <Img image={about.contactIllustration} sizes="(max-width: 700px) 100vw, 515px" />}
    </div>
    <div class="form-col">
      <h2 class="t-name">Get in touch</h2>
      <!-- Kein Server: „Send“ öffnet das Mailprogramm mit allen Angaben (siehe Script unten) -->
      <form class="form" id="contact-form" data-email={email} action={`mailto:${email}`} method="get">
        <div class="fields">
          <label class="field">
            <span class="visually-hidden">Name</span>
            <input type="text" name="name" placeholder="Name" autocomplete="name" required />
          </label>
          <label class="field">
            <span class="visually-hidden">E-Mail</span>
            <input type="email" name="email" placeholder="E-Mail" autocomplete="email" required />
          </label>
          <label class="field field-message">
            <span class="visually-hidden">Message</span>
            <textarea name="message" placeholder="Message" required></textarea>
          </label>
        </div>
        <Button type="submit">Send</Button>
        <p class="t-body fallback">
          Your email program will open with your message. If nothing happens, write to{' '}
          <a href={`mailto:${email}`}>{email}</a>{' '}
          <button type="button" class="copy" data-copy={email}>Copy address</button>
        </p>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const from = String(data.get('email') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();
    const subject = `Website inquiry from ${name}`;
    const body = `${message}\n\n—\n${name}\n${from}`;
    window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });

  // Adresse kopieren, falls sich kein Mailprogramm öffnet
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'Copied!';
      } catch {
        button.textContent = 'Please copy manually';
      }
      setTimeout(() => (button.textContent = 'Copy address'), 2000);
    });
  });
</script>

<style>
  /* ---------- About ---------- */
  .about {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 60px;
    /* Porträt schliesst direkt an die Navigation an (in Figma 40px Abstand) */
    padding: 0 0 0 var(--page-pad);
  }

  .text-col {
    display: flex;
    flex: 1 0 0;
    align-self: stretch;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 0 40px;
  }

  .text {
    color: var(--c-black);
  }

  .hello {
    color: var(--c-orange);
    font-family: var(--f-head);
    font-size: var(--t-headline);
    line-height: 1.625;
    text-box: trim-start cap alphabetic;
  }

  .lead,
  .body :global(p) {
    text-box: none;
  }

  /* Zwei Leerzeilen (Syne 20px) zwischen Lead und Fliesstext, je eine zwischen Absätzen – wie in Figma */
  .body {
    margin-top: calc(2 * 1.2em);
  }

  .body :global(* + *) {
    margin-top: 1.2em;
  }

  .body :global(h2) {
    font-family: var(--f-head);
    font-size: var(--t-body);
    font-weight: 400;
  }

  .body :global(a) {
    text-decoration: underline;
    text-underline-position: from-font;
  }

  .body :global(:last-child) {
    text-box: trim-end cap alphabetic;
  }

  .portrait {
    flex-shrink: 0;
    align-self: flex-start;
    width: min(644px, 45%);
    aspect-ratio: 644 / 928;
    background: var(--c-placeholder);
  }

  .portrait,
  .illu {
    overflow: hidden;
  }

  .portrait :global(img),
  .illu :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Contact ---------- */
  .contact {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(32px, 6.39vw, 100px);
    padding: 80px var(--page-pad) 40px;
    background: var(--c-butter);
  }

  .illu {
    flex: 0 1 515px;
    aspect-ratio: 515 / 514;
    background: var(--c-white);
  }

  .form-col {
    display: flex;
    flex-direction: column;
    flex: 0 1 693px;
    min-width: 0;
    gap: 40px;
    color: var(--c-black);
  }

  .form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
  }

  .fields {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    max-width: 690px;
  }

  .field input,
  .field textarea {
    display: block;
    width: 100%;
    height: 73px;
    padding: 0 21px;
    border: 1px solid var(--c-black);
    border-radius: var(--radius-input);
    background: transparent;
    font-family: var(--f-body);
    font-size: var(--t-body);
    line-height: normal;
    color: var(--c-black);
  }

  .field textarea {
    height: 211px;
    padding-top: 24px;
    resize: vertical;
  }

  .fallback {
    max-width: 560px;
    color: var(--c-offblack);
    font-size: 16px;
    text-box: none;
  }

  .fallback a {
    text-decoration: underline;
    text-underline-position: from-font;
  }

  .copy {
    margin-left: 6px;
    padding: 2px 10px;
    border: 1px solid var(--c-offblack);
    border-radius: 20px;
    background: transparent;
    font-family: var(--f-body);
    font-size: 14px;
    cursor: pointer;
  }

  .copy:hover {
    border-color: var(--c-orange);
    color: var(--c-orange);
  }

  .field ::placeholder {
    color: var(--c-black);
    opacity: 1;
  }

  .field input:focus,
  .field textarea:focus {
    outline: 2px solid var(--c-orange);
    outline-offset: -1px;
  }

  @media (max-width: 1100px) {
    .about {
      gap: var(--space-s);
    }

    .about {
      align-items: stretch;
    }

    .text-col {
      padding: var(--space-s) 0;
    }

    .portrait {
      aspect-ratio: auto;
    }

    .contact {
      padding: var(--space-l) var(--page-pad);
    }

    .illu {
      flex-basis: 40%;
    }

    .form-col {
      flex: 1 1 0;
    }

    .form-col,
    .form {
      gap: var(--space-s);
    }
  }

  /* Mobile: Porträt oben, Text darunter; Kontakt untereinander */
  @media (max-width: 700px) {
    .about {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0;
    }

    .portrait {
      order: -1;
      width: 100%;
      aspect-ratio: 4 / 5;
    }

    .text-col {
      padding: var(--space-s) var(--page-pad) var(--space-l);
    }

    .contact {
      flex-direction: column;
      align-items: stretch;
    }

    .illu,
    .form-col {
      flex: none;
      width: 100%;
    }

    .field input {
      height: 60px;
      padding: 0 16px;
    }

    .field textarea {
      height: 180px;
      padding: 18px 16px;
    }
  }
</style>
