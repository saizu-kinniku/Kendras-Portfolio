---
/** Figma: "select" – Default / Hover (Hover = aktiver Menüpunkt) */
interface Props {
  href: string;
  active?: boolean;
  tone?: 'dark' | 'light';
}

const { href, active = false, tone = 'dark' } = Astro.props;
---

<a
  class:list={['nav-link', `tone-${tone}`, { 'is-active': active }]}
  href={href}
  aria-current={active ? 'page' : undefined}
>
  <span class="trim"><slot /></span>
</a>

<style>
  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 15px;
    font-family: var(--f-body);
    font-size: var(--t-body);
    line-height: normal;
    text-align: center;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .tone-dark {
    color: var(--c-offblack);
  }

  .tone-light {
    color: var(--c-white);
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link.is-active {
    color: var(--c-orange);
  }

  /* Unterstrich wächst beim Hover von links nach rechts (Position/Stärke wie die Unterstreichung der Schrift) */
  .trim {
    position: relative;
  }

  .trim::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 0.11em);
    height: max(1px, 0.075em);
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link:hover .trim::after,
  .nav-link:focus-visible .trim::after,
  .nav-link.is-active .trim::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: reduce) {
    .trim::after {
      transition: none;
    }
  }
</style>
