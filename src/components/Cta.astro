---
/** Figma: "CTA" (Butter-Fläche mit Illustration) */
import Button from './Button.astro';
import Img from './Img.astro';
import { getSettings } from '../lib/content';

const settings = await getSettings();
---

<section class="cta">
  <div class="illu">
    {settings.ctaIllustration && <Img image={settings.ctaIllustration} sizes="(max-width: 700px) 100vw, 515px" />}
  </div>
  <div class="content">
    <h2 class="t-name">{settings.ctaTitle}</h2>
    <p class="t-body text">
      Feel free to contact me via DM on Instagram{' '}
      <a href={`https://instagram.com/${settings.instagram}`} target="_blank" rel="noopener">@{settings.instagram}</a> or write
      to me directly
    </p>
    <Button href="/about/#contact">Contact</Button>
  </div>
</section>

<style>
  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Spalten schrumpfen statt umzubrechen; ab ~1566px exakt wie Figma */
    gap: clamp(32px, 6.39vw, 100px);
    padding: 60px var(--page-pad);
    background: var(--c-butter);
  }

  .illu {
    flex: 0 1 515px;
    aspect-ratio: 515 / 514;
    overflow: hidden;
    background: var(--c-white);
  }

  .illu :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 0 1 693px;
    min-width: 0;
    gap: 73px;
    color: var(--c-black);
  }

  .text {
    width: 617px;
    max-width: 100%;
  }

  @media (max-width: 1100px) {
    .cta {
      padding: var(--space-l) var(--page-pad);
    }

    .illu {
      flex-basis: 40%;
    }

    .content {
      flex: 1 1 0;
      gap: var(--space-s);
    }
  }

  @media (max-width: 700px) {
    .cta {
      flex-direction: column;
      align-items: stretch;
    }

    .illu,
    .content {
      flex: none;
      width: 100%;
    }
  }
</style>
