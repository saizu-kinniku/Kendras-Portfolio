{
  "name": "kendra-portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "studio": "npm --prefix studio run dev",
    "build": "astro build && npm run build:studio",
    "build:studio": "npm --prefix studio ci --no-audit --no-fund && SANITY_STUDIO_PROJECT_ID=${SANITY_PROJECT_ID:-kkd7bqq0} SANITY_STUDIO_DATASET=${SANITY_DATASET:-production} npm --prefix studio run build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource/stack-sans-headline": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@portabletext/to-html": "^6.0.0",
    "@sanity/client": "^8.16.0",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.4.12"
  }
}
